      "error": {
        "status": 500,
        "message": "Internal server error"
      }
    },
    {
      "error": {
        "status": 503,
        "message": "Service unavailable"
      }
    },
    {
      "response": {
        "content": "ok",
        "finish_reason": "stop"
      }
    }
  ]
}
