#!/usr/bin/env bash
# Demo launcher. Default (Builder-first): start the backend (DEMO_MODE=1, data/demo.db) and the frontend,
# print the Builder URL, wait for the app you build there, then run the Campus Alert simulator against it.
# Usage: tools/demo [--app ID --ingest-key KEY [--authority-key KEY] [--input-map MAP]] [--fresh] [--no-sim]
#        tools/demo --from-spec <campus-alert|flyway> [--fresh] [--no-sim]
#   --app ID              the app id you built in the Builder (else asked on the terminal)
#   --ingest-key KEY      its ingest key, shown once at confirm (else asked on the terminal)
#   --authority-key KEY   optional: the sim checks the app's inputs and drops undeclared fields; also resumes the clock
#   --input-map MAP       optional, passed to the sim: panic=<id>,room_button=<id>,police_marker=<id>
#   --from-spec APP       emergency fallback: create + activate the app from specs/APP.json (no live compile)
#   --fresh               start from an empty demo DB (keys change; the old ones stop working)
#   --no-sim              bring everything up but don't start the simulator
# Ctrl-C stops everything it started. Keys live in data/ (gitignored) or your terminal; never commit them.
set -euo pipefail

FROM_SPEC=""
APP=""
INGEST=""
AUTH=""
INPUT_MAP=""
FRESH=0
SIM=1
need() { [ $# -ge 2 ] && [ -n "$2" ] || { echo "demo: $1 needs a value (try --help)" >&2; exit 2; }; }
while [ $# -gt 0 ]; do
  case "$1" in
    --from-spec) need "$@"; FROM_SPEC="$2"; shift ;;
    --app) need "$@"; APP="$2"; shift ;;
    --ingest-key) need "$@"; INGEST="$2"; shift ;;
    --authority-key) need "$@"; AUTH="$2"; shift ;;
    --input-map) need "$@"; INPUT_MAP="$2"; shift ;;
    --fresh) FRESH=1 ;;
    --no-sim) SIM=0 ;;
    -h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "demo: unknown argument '$1' (try --help)" >&2; exit 2 ;;
  esac
  shift
done
case "$FROM_SPEC" in
  ""|campus-alert|flyway) ;;
  *) echo "demo: --from-spec takes campus-alert or flyway" >&2; exit 2 ;;
esac
if [ -n "$FROM_SPEC" ] && { [ -n "$APP" ] || [ -n "$INGEST" ] || [ -n "$AUTH" ]; }; then
  echo "demo: --from-spec creates its own app and keys; drop --app/--ingest-key/--authority-key" >&2; exit 2
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DATA="$ROOT/data"
DB="$DATA/demo.db"
API="http://127.0.0.1:8000"
mkdir -p "$DATA"

PY="$ROOT/backend/.venv/Scripts/python"
[ -x "$PY" ] || PY="$ROOT/backend/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3 || command -v python)"
command -v npm >/dev/null || { echo "demo: npm not found" >&2; exit 1; }

if [ "$FRESH" = 1 ]; then rm -f "$DB" "$DATA"/demo-keys-*.json; fi

PIDS=()
cleanup() {
  trap - EXIT INT TERM
  echo; echo "demo: stopping..."
  for p in "${PIDS[@]:-}"; do [ -n "$p" ] && kill "$p" 2>/dev/null || true; done
}
trap cleanup EXIT INT TERM

json() { "$PY" -c "import json,sys; print(json.load(sys.stdin)$1)"; }

echo "demo: backend on :8000 (DEMO_MODE=1, db $DB)"
( cd "$ROOT/backend" && DEMO_MODE=1 SQLITE_PATH="$DB" exec "$PY" -m uvicorn app.main:app --port 8000 ) \
  > "$DATA/demo-backend.log" 2>&1 &
PIDS+=($!)
echo "demo: frontend on :5173 (also on your LAN IP for phones)"
( cd "$ROOT/frontend" && exec npx vite --port 5173 --strictPort ) > "$DATA/demo-frontend.log" 2>&1 &
PIDS+=($!)

for _ in $(seq 1 60); do curl -sf "$API/v1/health" >/dev/null && break; sleep 0.5; done
curl -sf "$API/v1/health" >/dev/null || { echo "demo: backend didn't start; see data/demo-backend.log" >&2; exit 1; }

if [ -n "$FROM_SPEC" ]; then
  # Emergency fallback: the hand-written spec, no live compile.
  APP="$FROM_SPEC"
  KEYS="$DATA/demo-keys-$APP.json"
  code=$(curl -s -o /dev/null -w "%{http_code}" -X POST "$API/v1/apps" -H "Content-Type: application/json" \
    --data-binary "@$ROOT/specs/$APP.json")
  case "$code" in
    201) echo "demo: created $APP from specs/$APP.json" ;;
    409) echo "demo: $APP already exists" ;;
    *) echo "demo: creating $APP failed (HTTP $code)" >&2; exit 1 ;;
  esac
  if [ ! -s "$KEYS" ]; then
    if ! curl -sf -X POST "$API/v1/apps/$APP/activate" > "$KEYS.tmp"; then
      rm -f "$KEYS.tmp"
      echo "demo: $APP is active but its keys aren't in $KEYS; rerun with --fresh" >&2; exit 1
    fi
    mv "$KEYS.tmp" "$KEYS"
  fi
  INGEST=$(json "['ingest_key']" < "$KEYS")
  AUTH=$(json "['authority_key']" < "$KEYS")
  KEYS_NOTE="$KEYS   (gitignored; shown once at activation)"
else
  # Builder-first: the dev builds the app live in the browser; we only need its id and ingest key.
  cat <<EOF

  Builder:  http://localhost:5173/
  Build the app there (docs/DEMO.md has the exact text), confirm, and copy both keys.

EOF
  if [ "$SIM" = 1 ] && { [ -z "$APP" ] || [ -z "$INGEST" ]; }; then
    [ -t 0 ] || { echo "demo: no terminal to ask on; pass --app and --ingest-key" >&2; exit 2; }
    [ -n "$APP" ] || { read -r -p "App id [campus-alert]: " APP; APP="${APP:-campus-alert}"; }
    while [ -z "$INGEST" ]; do read -r -p "Ingest key: " INGEST; done
    [ -n "$AUTH" ] || read -r -p "Authority key (optional, Enter to skip): " AUTH
  fi
  KEYS_NOTE="not stored; keep your copy from the Builder"
fi

if [ -n "$APP" ]; then
  cat <<EOF

  Console (authority):  http://localhost:5173/apps/$APP
  Authority key:        ${AUTH:-(the one the Builder showed you)}
  End-user page:        http://localhost:5173/apps/$APP/go
  Keys:                 $KEYS_NOTE
  Logs:                 data/demo-backend.log, data/demo-frontend.log

EOF
else
  echo "  Logs: data/demo-backend.log, data/demo-frontend.log"; echo
fi

if [ "$SIM" = 1 ]; then
  # The sim follows the server clock, so the server clock sets the pace: campus-alert runs at 1x,
  # flyway's 75 min of tag data at 20x (about 4 min). Change it live with Pause/Speed in the console.
  SPEED=1
  [ "$FROM_SPEC" = "flyway" ] && SPEED=20
  if [ -n "$AUTH" ]; then
    curl -sf -X POST "$API/v1/debug/apps/$APP/clock" -H "X-Authority-Key: $AUTH" -H "Content-Type: application/json" \
      -d "{\"paused\": false, \"speed\": $SPEED}" > /dev/null \
      || echo "demo: couldn't set the clock (wrong authority key?); the sim follows it as it is" >&2
  fi
  echo "demo: simulator at ${SPEED}x (--follow-clock: Pause/Speed in the console drive it)"
  cd "$ROOT"
  export PYTHONUNBUFFERED=1
  if [ "$FROM_SPEC" = "flyway" ]; then
    INGEST_KEY="$INGEST" "$PY" -m sim.flyway --api "$API" --follow-clock
  else
    SIM_ARGS=(--api "$API" --app "$APP" --follow-clock)
    # --authority-key only when the Builder path gave one: the hand-written spec already matches the sim.
    [ -n "$AUTH" ] && [ -z "$FROM_SPEC" ] && SIM_ARGS+=(--authority-key "$AUTH")
    [ -n "$INPUT_MAP" ] && SIM_ARGS+=(--input-map "$INPUT_MAP")
    INGEST_KEY="$INGEST" "$PY" -m sim.campus_alert "${SIM_ARGS[@]}" || echo "demo: simulator stopped (see above)" >&2
  fi
  echo "demo: simulator finished; the map keeps ticking. Ctrl-C to stop."
fi
wait
